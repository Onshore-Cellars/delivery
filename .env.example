# ─── DATABASE ─────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/onshore_deliver"
DIRECT_URL="postgresql://user:password@localhost:5432/onshore_deliver"

# ─── AUTH ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="https://localhost:3000"

# ─── STRIPE ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── VAT / TAX ────────────────────────────────────────────────────
# Where Onshore is VAT-established. This is THE knob that sets which
# country's VAT applies to domestic sales and how cross-border resolves.
# Use a VAT country code: an EU state (FR, IE, NL, DE…) or GB.
PLATFORM_VAT_COUNTRY="GB"
# Onshore's own VAT registration number (printed on invoices). Required for
# a valid VAT invoice once you charge VAT.
PLATFORM_VAT_NUMBER=""
# Set to "false" if Onshore is not yet VAT-registered (no VAT is charged).
PLATFORM_VAT_REGISTERED="true"
# EU VAT numbers are verified live against the EU VIES service
# (ec.europa.eu) — no key needed; the check fails safe if VIES is down.

# ─── GOOGLE ───────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY="AIza..."
# GOOGLE_CLIENT_ID="..."       # Optional: Google OAuth
# GOOGLE_CLIENT_SECRET="..."   # Optional: Google OAuth
# NEXT_PUBLIC_GOOGLE_CLIENT_ID="..."  # Client-side Google OAuth

# ─── EMAIL (choose one) ──────────────────────────────────────────
# Option 1: SMTP
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="your-app-password"

# Option 2: Resend
# RESEND_API_KEY="re_..."

# From address for all emails
# EMAIL_FROM="info@onshoredelivery.com"

# ─── AI (Claude) ─────────────────────────────────────────────────
# ANTHROPIC_API_KEY="sk-ant-..."  # Required for AI features

# ─── ADMIN ────────────────────────────────────────────────────────
# Comma-separated emails that auto-get ADMIN role on login
ADMIN_EMAILS="admin@onshoredelivery.com"

# ─── FILE STORAGE (S3-compatible) ─────────────────────────────────
# STORAGE_BUCKET="onshore-deliver"
# STORAGE_REGION="eu-west-1"
# STORAGE_ACCESS_KEY="..."
# STORAGE_SECRET_KEY="..."
# STORAGE_ENDPOINT=""           # For R2/MinIO
# STORAGE_PUBLIC_URL=""         # CDN URL

# ─── AIS VESSEL TRACKING ────────────────────────────────────────
# AISSTREAM_API_KEY="..."       # Free API key from https://aisstream.io

# ─── REDIS (distributed rate limiting) ──────────────────────────
# REDIS_URL="redis://localhost:6379"  # Optional: enables distributed rate limiting

# ─── CRON / AUTOMATION ───────────────────────────────────────────
# CRON_SECRET="..."             # Shared secret for cron endpoints

# ─── VEHICLE LOOKUPS ────────────────────────────────────────────
# DVLA_API_KEY="..."            # UK DVLA vehicle lookup
# EU_VEHICLE_API_KEY="..."      # EU vehicle registration lookup

# ─── PUSH NOTIFICATIONS ──────────────────────────────────────────
# VAPID_PUBLIC_KEY="..."
# VAPID_PRIVATE_KEY="..."
# VAPID_EMAIL="mailto:admin@onshoredelivery.com"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."  # Client-side VAPID key
